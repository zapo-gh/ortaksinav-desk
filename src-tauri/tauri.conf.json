{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Ortak Sinav Yerlesim Sistemi",
  "version": "0.1.2",
  "identifier": "com.kelebek.sinavsistemi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Ortak Sınav Yerleşim Sistemi",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "backgroundColor": "#1976d2"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg0OTBCQUMwOTM2NEY2QzcKUldUSDltU1R3THFRaFBaUnJqa1RLZmNvNzcwRWEyQ1ZBSHc5TjNEUXdCZzIxeFZjK0dWZHdZcVIK",
      "endpoints": [
        "https://github.com/zapo-gh/ortaksinav-desk/releases/latest/download/updater.json"
      ]
    }
  }
}